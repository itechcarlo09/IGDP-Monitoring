{
	"name": "IGDPMonitoring",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"update-env": "node scripts/update-env.js",
		"android:stag": "yarn update-env && ENVFILE=.env.staging react-native run-android",
		"android": "yarn update-env && ENVFILE=.env.development react-native run-android",
		"android:reset": "yarn update-env && ENVFILE=.env.development react-native run-android --reset-cache",
		"android:prod": "ENVFILE=.env.production react-native run-android",
		"ios": "yarn update-env && ENVFILE=.env.development react-native run-ios",
		"ios:prod": "ENVFILE=.env.production react-native run-ios",
		"lint": "eslint .",
		"start": "react-native start",
		"test": "jest"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@react-native-async-storage/async-storage": "^3.1.0",
		"@react-native-clipboard/clipboard": "^1.16.3",
		"@react-native-masked-view/masked-view": "^0.3.2",
		"@react-native/new-app-screen": "0.80.1",
		"@react-navigation/bottom-tabs": "^7.4.2",
		"@react-navigation/native": "^7.1.14",
		"@react-navigation/native-stack": "^7.3.21",
		"@tanstack/react-query": "^5.95.2",
		"@types/react-native-vector-icons": "^6.4.18",
		"axios": "^1.11.0",
		"dayjs": "^1.11.13",
		"formik": "^2.4.6",
		"gensync": "^1.0.0-beta.2",
		"react": "19.1.0",
		"react-native": "0.80.1",
		"react-native-config": "^1.5.5",
		"react-native-date-picker": "^5.0.13",
		"react-native-element-dropdown": "^2.12.4",
		"react-native-gesture-handler": "^2.27.1",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-keyboard-controller": "^1.20.7",
		"react-native-linear-gradient": "^2.8.3",
		"react-native-reanimated": "^3.18.0",
		"react-native-safe-area-context": "^5.5.2",
		"react-native-screens": "^4.13.1",
		"react-native-svg": "^15.12.1",
		"react-native-vector-icons": "^10.3.0",
		"yup": "^1.6.1",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/preset-env": "^7.25.3",
		"@babel/runtime": "^7.25.0",
		"@react-native-community/cli": "19.0.0",
		"@react-native-community/cli-platform-android": "19.0.0",
		"@react-native-community/cli-platform-ios": "19.0.0",
		"@react-native/babel-preset": "0.80.1",
		"@react-native/eslint-config": "0.80.1",
		"@react-native/metro-config": "0.80.1",
		"@react-native/typescript-config": "0.80.1",
		"@types/jest": "^29.5.13",
		"@types/react": "^19.1.0",
		"@types/react-test-renderer": "^19.1.0",
		"babel-plugin-module-resolver": "^5.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^8.19.0",
		"jest": "^29.6.3",
		"prettier": "2.8.8",
		"react-test-renderer": "19.1.0",
		"typescript": "5.0.4"
	},
	"engines": {
		"node": ">=18"
	}
}
